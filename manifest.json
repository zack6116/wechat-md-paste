{
  "manifest_version": 3,
  "name": "公众号 MD Paste",
  "version": "1.0.11",
  "description": "在公众号图文编辑页导入 Markdown，图片在本地处理后写入草稿，不会自动发布。",
  "permissions": ["storage", "scripting", "downloads"],
  "host_permissions": ["https://mp.weixin.qq.com/*", "http://127.0.0.1:9765/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "公众号 MD Paste",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["src/page/main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel/panel.html",
        "src/panel/panel.js",
        "src/panel/panel.css",
        "src/panel/folder-store.js",
        "src/content/bridge.js",
        "src/lib/article.js",
        "src/lib/bundle.js",
        "src/lib/bytes.js",
        "src/lib/channel.js",
        "src/lib/constants.js",
        "src/lib/drop-files.js",
        "src/lib/entitlement.js",
        "src/lib/import-log.js",
        "src/lib/images.js",
        "src/lib/license.js",
        "src/lib/markdown.js",
        "src/lib/placement.js",
        "src/lib/render.js",
        "src/lib/resolve-images.js",
        "src/lib/urls.js"
      ],
      "matches": ["https://mp.weixin.qq.com/*"]
    }
  ]
}
